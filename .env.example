# Server configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# Qdrant Cloud Inference only; Pinecone remains the vector store.
DENSE_EMBEDDING_BACKEND=qdrant
QDRANT_INFERENCE_CONCURRENCY=8
QDRANT_INFERENCE_MAX_RETRIES=8
QDRANT_PREFER_GRPC=false
QDRANT_URL=https://xxxx.qdrant.tech
QDRANT_API_KEY=
QDRANT_INFERENCE_COLLECTION_NAME=vietlex-embedding-staging
QDRANT_RERANK_COLLECTION_NAME=vietlex-rerank-staging
QDRANT_RERANK_MODEL=answerdotai/answerai-colbert-small-v1
QDRANT_RERANK_VECTOR_NAME=colbert
QDRANT_RERANK_VECTOR_SIZE=96
QDRANT_RERANK_TIMEOUT_SECONDS=12
QDRANT_RERANK_MAX_RETRIES=2

# Pinecone vector storage. The application supports both key spellings.
PIPECONE_API=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=vietlex-legal-rag-v1
PINECONE_NAMESPACE=legal-documents-v1
PINECONE_CACHE_NAMESPACE=semantic-cache-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
PINECONE_RERANK_TIMEOUT_SECONDS=12

# Cohere API (Reranking)
COHERE_API_KEY=

OMNIGATE_BASE_URL=https://llmgateway.onrender.com
LITELLM_MASTER_KEY=

# Logfire Tracing
LOGFIRE_TOKEN=

# Runtime retrieval and LLM budgets
RETRIEVAL_DOCUMENT_LIMIT=24
QUERY_CHUNK_MAX_TOKENS=220
QUERY_CHUNK_OVERLAP_TOKENS=24
RERANK_CANDIDATE_LIMIT=12
RERANK_PER_DOCUMENT_LIMIT=2
RERANK_RETURN_LIMIT=6
RERANK_MIN_SCORE=0.05
RERANK_TOP_K=3
RERANK_CIRCUIT_BREAKER_FAILURES=2
RERANK_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
LLM_CONTEXT_MAX_TOKENS=720
LLM_CONTEXT_PER_DOCUMENT_LIMIT=2
LLM_MAX_OUTPUT_TOKENS=640
QUERY_REWRITE_MAX_CHARACTERS=2000
QUERY_REWRITE_MAX_OUTPUT_TOKENS=96

# Pinned external legal corpus
DATASET_REPOSITORY=vohuutridung/vietnamese-legal-documents
DATASET_REVISION=4d4e10b201544e8a4c49a1d3fa496595a7d486d0
EXPECTED_DOCUMENT_COUNT=518255
DATASET_ROOT=data/huggingface
CONTENT_STORE_PATH=data/huggingface/content_store.sqlite3
INGESTION_STATE_PATH=data/huggingface/ingestion_state.sqlite3
INGESTION_REPORT_PATH=data/huggingface/ingestion_report.json
PINECONE_INGESTION_STATE_PATH=data/huggingface/pinecone_ingestion_state.sqlite3
PINECONE_INGESTION_REPORT_PATH=data/huggingface/pinecone_ingestion_report.json
LEGAL_FTS_PATH=data/huggingface/legal_fts.sqlite3
LEGAL_FTS_RESULT_LIMIT=12
