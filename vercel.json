{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "python -m pip install -r requirements-demo.lock && python -m pip install . --no-deps",
  "functions": {
    "app/server.py": {
      "maxDuration": 300,
      "excludeFiles": "{data/**,tests/**,output/**,tmp/**,.env,.env.*,requirements.txt,Dockerfile,guardrails_config/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
